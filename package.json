{
  "name": "mcp-remote",
  "version": "0.1.38",
  "description": "Remote proxy for Model Context Protocol, allowing local-only clients to connect to remote servers using oAuth",
  "keywords": [
    "mcp",
    "stdio",
    "sse",
    "remote",
    "oauth"
  ],
  "author": "Glen Maddern <glen@glenmaddern.com>",
  "license": "MIT",
  "repository": "https://github.com/punkpeye/mcp-remote",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "mcp-remote": "dist/proxy.js",
    "mcp-remote-client": "dist/client.js"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "dev:client": "tsx src/client.ts",
    "dev:proxy": "tsx src/proxy.ts",
    "format": "oxfmt .",
    "knip": "knip",
    "lint": "oxfmt --check . && oxlint --deny-warnings && tsc && tsc -p test --noEmit",
    "prepack": "tsup",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "express": "^4.21.2",
    "open": "^10.1.0",
    "strict-url-sanitise": "^0.0.1",
    "undici": "^7.12.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "husky": "9.1.7",
    "knip": "6.32.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "semantic-release": "^25.0.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.3",
    "zod": "^4.0.0"
  },
  "tsup": {
    "entry": [
      "src/client.ts",
      "src/proxy.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "clean": true,
    "outDir": "dist",
    "external": []
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977"
}
